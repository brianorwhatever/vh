{
  "description": "did:vh src references (didvh-src). Valid references give the kind and the URLs of did.jsonl and did-witness.json; invalid ones give invalidOptions.",
  "spec": [
    "https://github.com/swcurran/didvh-old/blob/6c2e753/spec/specification.md#the-src-option",
    "docs/didvh-profile.md#3-src-references"
  ],
  "cases": [
    {
      "name": "root",
      "src": "https://example.com",
      "expect": {
        "valid": true,
        "kind": "web",
        "didLog": "https://example.com/.well-known/did.jsonl",
        "didWitness": "https://example.com/.well-known/did-witness.json"
      }
    },
    {
      "name": "root-slash",
      "src": "https://example.com/",
      "expect": {
        "valid": true,
        "kind": "web",
        "didLog": "https://example.com/.well-known/did.jsonl",
        "didWitness": "https://example.com/.well-known/did-witness.json"
      }
    },
    {
      "name": "path",
      "src": "https://example.com/dids/issuer",
      "expect": {
        "valid": true,
        "kind": "web",
        "didLog": "https://example.com/dids/issuer/did.jsonl",
        "didWitness": "https://example.com/dids/issuer/did-witness.json"
      }
    },
    {
      "name": "path-slash",
      "src": "https://example.com/dids/issuer/",
      "expect": {
        "valid": true,
        "kind": "web",
        "didLog": "https://example.com/dids/issuer/did.jsonl",
        "didWitness": "https://example.com/dids/issuer/did-witness.json"
      }
    },
    {
      "name": "port",
      "src": "https://example.com:3000/dids/issuer",
      "expect": {
        "valid": true,
        "kind": "web",
        "didLog": "https://example.com:3000/dids/issuer/did.jsonl",
        "didWitness": "https://example.com:3000/dids/issuer/did-witness.json"
      }
    },
    {
      "name": "scid-path",
      "src": "https://example.com/users/QmfGEUAcMpzo25kF2Rhn8L5FAXysfGnkzjwdKoNPi615XQ",
      "expect": {
        "valid": true,
        "kind": "web",
        "didLog": "https://example.com/users/QmfGEUAcMpzo25kF2Rhn8L5FAXysfGnkzjwdKoNPi615XQ/did.jsonl",
        "didWitness": "https://example.com/users/QmfGEUAcMpzo25kF2Rhn8L5FAXysfGnkzjwdKoNPi615XQ/did-witness.json"
      }
    },
    {
      "name": "uppercase-scheme-and-host",
      "src": "HTTPS://Example.COM/Dids",
      "expect": {
        "valid": true,
        "kind": "web",
        "didLog": "https://Example.COM/Dids/did.jsonl",
        "didWitness": "https://Example.COM/Dids/did-witness.json"
      }
    },
    {
      "name": "percent-encoded-segment",
      "src": "https://example.com/a%20b",
      "expect": {
        "valid": true,
        "kind": "web",
        "didLog": "https://example.com/a%20b/did.jsonl",
        "didWitness": "https://example.com/a%20b/did-witness.json"
      }
    },
    {
      "name": "trailing-dot-host",
      "src": "https://example.com./dids",
      "expect": {
        "valid": true,
        "kind": "web",
        "didLog": "https://example.com./dids/did.jsonl",
        "didWitness": "https://example.com./dids/did-witness.json"
      }
    },
    {
      "name": "punycode-host",
      "src": "https://xn--bcher-kva.example/dids",
      "expect": {
        "valid": true,
        "kind": "web",
        "didLog": "https://xn--bcher-kva.example/dids/did.jsonl",
        "didWitness": "https://xn--bcher-kva.example/dids/did-witness.json"
      }
    },
    {
      "name": "double-trailing-slash",
      "src": "https://example.com/dids//",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "empty-segment",
      "src": "https://example.com/a//b",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "dot-segment",
      "src": "https://example.com/a/./b",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "dot-dot-segment",
      "src": "https://example.com/a/../b",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "encoded-dot-dot",
      "src": "https://example.com/a/%2E%2E/b",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "encoded-slash",
      "src": "https://example.com/a%2Fb",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "encoded-backslash",
      "src": "https://example.com/a%5Cb",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "encoded-nul",
      "src": "https://example.com/a%00b",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "leading-space",
      "src": "https://example.com/%20a",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "trailing-nbsp",
      "src": "https://example.com/a%C2%A0",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "inner-space",
      "src": "https://example.com/a%20b/c",
      "expect": {
        "valid": true,
        "kind": "web",
        "didLog": "https://example.com/a%20b/c/did.jsonl",
        "didWitness": "https://example.com/a%20b/c/did-witness.json"
      }
    },
    {
      "name": "bad-percent",
      "src": "https://example.com/a%zz",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "bad-utf8",
      "src": "https://example.com/a%FF",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "query",
      "src": "https://example.com/dids?x=1",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "fragment",
      "src": "https://example.com/dids#x",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "userinfo",
      "src": "https://user@example.com/dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "ipv4-host",
      "src": "https://192.0.2.1/dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "ipv6-host",
      "src": "https://[2001:db8::1]/dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "numeric-tld",
      "src": "https://example.123/dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "empty-host",
      "src": "https:///dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "bad-port",
      "src": "https://example.com:99999/dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "empty-port",
      "src": "https://example.com:/dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "underscore-host",
      "src": "https://ex_ample.com/dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "no-authority",
      "src": "https:example.com/dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "unicode-host",
      "src": "https://bücher.example/dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "space",
      "src": "https://example.com/a b",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "localhost",
      "src": "http://localhost:8000/dids/issuer",
      "expect": {
        "valid": true,
        "kind": "loopback",
        "didLog": "http://localhost:8000/dids/issuer/did.jsonl",
        "didWitness": "http://localhost:8000/dids/issuer/did-witness.json"
      }
    },
    {
      "name": "loopback-ipv4",
      "src": "http://127.0.0.1/dids",
      "expect": {
        "valid": true,
        "kind": "loopback",
        "didLog": "http://127.0.0.1/dids/did.jsonl",
        "didWitness": "http://127.0.0.1/dids/did-witness.json"
      }
    },
    {
      "name": "loopback-ipv4-other",
      "src": "http://127.10.20.30:8080",
      "expect": {
        "valid": true,
        "kind": "loopback",
        "didLog": "http://127.10.20.30:8080/.well-known/did.jsonl",
        "didWitness": "http://127.10.20.30:8080/.well-known/did-witness.json"
      }
    },
    {
      "name": "loopback-ipv6",
      "src": "http://[::1]:8000/dids",
      "expect": {
        "valid": true,
        "kind": "loopback",
        "didLog": "http://[::1]:8000/dids/did.jsonl",
        "didWitness": "http://[::1]:8000/dids/did-witness.json"
      }
    },
    {
      "name": "http-public",
      "src": "http://example.com/dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "http-private",
      "src": "http://10.0.0.1/dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "http-leading-zero",
      "src": "http://127.0.0.01/dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "file-empty-host",
      "src": "file:///var/lib/wallet/dids/QmfGEU",
      "expect": {
        "valid": true,
        "kind": "file",
        "didLog": "file:///var/lib/wallet/dids/QmfGEU/did.jsonl",
        "didWitness": "file:///var/lib/wallet/dids/QmfGEU/did-witness.json"
      }
    },
    {
      "name": "file-localhost",
      "src": "file://localhost/home/alice/dids/QmfGEU/",
      "expect": {
        "valid": true,
        "kind": "file",
        "didLog": "file:///home/alice/dids/QmfGEU/did.jsonl",
        "didWitness": "file:///home/alice/dids/QmfGEU/did-witness.json"
      }
    },
    {
      "name": "file-no-authority",
      "src": "file:/var/lib/dids",
      "expect": {
        "valid": true,
        "kind": "file",
        "didLog": "file:///var/lib/dids/did.jsonl",
        "didWitness": "file:///var/lib/dids/did-witness.json"
      }
    },
    {
      "name": "file-root",
      "src": "file:///",
      "expect": {
        "valid": true,
        "kind": "file",
        "didLog": "file:///did.jsonl",
        "didWitness": "file:///did-witness.json"
      }
    },
    {
      "name": "file-other-host",
      "src": "file://server/share/dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "file-relative",
      "src": "file:dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "file-query",
      "src": "file:///var/lib/dids?x",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "ipns",
      "src": "ipns://k51qzi5uqu5d/dids/issuer",
      "expect": {
        "valid": true,
        "kind": "other",
        "didLog": "ipns://k51qzi5uqu5d/dids/issuer/did.jsonl",
        "didWitness": "ipns://k51qzi5uqu5d/dids/issuer/did-witness.json"
      }
    },
    {
      "name": "ipfs",
      "src": "ipfs://bafybeigdyrzt/",
      "expect": {
        "valid": true,
        "kind": "other",
        "didLog": "ipfs://bafybeigdyrzt/did.jsonl",
        "didWitness": "ipfs://bafybeigdyrzt/did-witness.json"
      }
    },
    {
      "name": "urn",
      "src": "urn:example:dids",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "did",
      "src": "did:web:example.com",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "other-empty-authority",
      "src": "ipfs:///x",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "relative",
      "src": "/dids/issuer",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "empty",
      "src": "",
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    },
    {
      "name": "number",
      "src": 42,
      "expect": {
        "valid": false,
        "error": "invalidOptions"
      }
    }
  ]
}
